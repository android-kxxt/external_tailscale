package {
    default_applicable_licenses: ["BSD-3-Clause"],
}

license {
    name: "BSD-3-Clause",
    license_text: [
        "LICENSE",
    ]
}

// The UI depends on this target so a checkout without its companion daemon
// policy or matching prebuilts fails at build time instead of on the device.
phony {
    name: "tailscale-system-ui-support",
    required: ["tailscaled-system-ui", "init.tailscale.rc"],
}

prebuilt_etc {
    name: "init.tailscale.rc",
    src: "init.tailscale.rc",
    system_ext_specific: true,
    sub_dir: "init",
    visibility: ["//visibility:public"],
}
